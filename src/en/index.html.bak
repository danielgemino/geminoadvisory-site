  <!-- SEO (hreflang) -->
  <link rel="alternate" hreflang="es" href="https://www.geminoadvisory.com/es/" />
  <link rel="alternate" hreflang="en" href="https://www.geminoadvisory.com/en/" />
  <link rel="alternate" hreflang="pt-BR" href="https://www.geminoadvisory.com/pt-br/" />
  <link rel="alternate" hreflang="x-default" href="https://www.geminoadvisory.com/" />
</head>

<body>
<header>
  <div class="brand">
    <img src="/assets/img/logo.png" alt="Gemino Advisory" />
    <div>
      <div class="brand-name">Gemino Advisory</div>
      <div class="brand-tagline">Strategic Risk & Compliance</div>
    </div>
  </div>

  <nav class="main-nav">
    <a href="/en/">Home</a>
    <a href="/en/about.html">About Us</a>
    <a href="/en/services.html">Services</a>
    <a href="/en/resources.html">Resources</a>
    <a href="/en/contact.html">Contact</a>
  </nav>

  <div class="lang-switch">
    <a href="/es/" id="lang-es">🇪🇸</a>
    <a href="/en/" id="lang-en">🇺🇸</a>
    <a href="/pt-br/" id="lang-pt">🇧🇷</a>
  </div>
</header>

<!-- BLOCK 1: Two-column hero -->
<section class="hero hero-split">
  <div class="hero-left">
    <h1>We structure trust in complex environments.</h1>
    <div class="hero-cta">
      <a class="btn btn-primary" href="mailto:daniel@geminoadvisory.com">Contact</a>
      <a class="btn btn-secondary" href="/en/contact.html">Book 15 min (coming soon)</a>
    </div>
  </div>

  <div class="hero-right">
    <p>
      Gemino Advisory supports organizations and investors in navigating regulatory, operational, and relational risk across emerging markets.
    </p>
    <p>
      Our approach integrates compliance, strategic structuring, and risk intelligence into a single decision framework.
    </p>
  </div>
</section>

<!-- BLOCK 2: Lines of Services + service tiles -->
<section class="section">
  <h2 class="section-title">Lines of Services</h2>

  <p class="section-intro">
    We work with organizations facing regulatory, operational, and relational complexity.<br />
    Strategic advisory across regulatory, operational, and relational risk.
  </p>

  <div class="grid grid-squares">
    <div class="card card-square">
      <h3>Compliance & Regulatory Exposure Diagnostic</h3>
      <p><b>Objective:</b> Provide a clear, structured, and actionable view of the organization’s current compliance posture against applicable regulatory frameworks, including exposure risks, critical gaps, and priority actions.</p>
    </div>

    <div class="card card-square">
      <h3>Preparation & Adaptation to New Regulatory Requirements</h3>
      <p><b>Objective:</b> Support the organization through a structured transition toward compliance with new laws, regulations, or supervisory requirements.</p>
    </div>

    <div class="card card-square">
      <h3>Design & Strengthening of the Compliance Framework (AML/CFT)</h3>
      <p><b>Objective:</b> Design or reinforce the organization’s compliance system using a risk‑based approach aligned with international standards and local requirements.</p>
    </div>

    <div class="card card-square">
      <h3>Governance, Culture & Integrated Compliance Risk Management</h3>
      <p><b>Objective:</b> Integrate compliance within the corporate governance model and organizational culture to ensure sustainability and long‑term effectiveness.</p>
    </div>
  

  <div class="after-services-card">
  <p>
    Gemino Advisory operates at the intersection of regulatory intelligence, business strategy, and risk structuring.<br />
    We support decision‑making in environments where compliance, operational execution, and stakeholder alignment must be addressed simultaneously.
  </p>
  <p class="closing-line">Where complexity exists, structure becomes critical.</p>
</div>

</div>

  </section>

<footer>
  daniel@geminoadvisory.com · Guatemala | Central America | United States
</footer>

